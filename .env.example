# Supabase (dashboard realtime + persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SRE console
ADMIN_KEY=choose-a-long-random-value

# Signed webhooks: X-Pulse-Signature: sha256=<hex hmac of raw body>
WEBHOOK_URL=https://example.com/pulse-hook
WEBHOOK_SECRET=choose-a-webhook-secret

# Optional target overrides (4 services)
SERVICE_QUOTES_URL=https://httpbin.org/status/200
SERVICE_PAYMENTS_URL=https://api.github.com/zen
SERVICE_CLAIMS_URL=https://jsonplaceholder.typicode.com/todos/1
SERVICE_NOTIFICATIONS_URL=https://postman-echo.com/status/200
