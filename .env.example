# Supabase (dashboard realtime + persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SRE console
ADMIN_KEY=choose-a-long-random-value

# Signed webhooks: X-Pulse-Signature: sha256=<hex hmac of raw body>
WEBHOOK_URL=https://example.com/pulse-hook
WEBHOOK_SECRET=choose-a-webhook-secret

# Optional target overrides; defaults target the local Docker services.
SERVICE_QUOTES_URL=http://localhost:4101/health
SERVICE_PAYMENTS_URL=http://localhost:4102/health
SERVICE_CLAIMS_URL=http://localhost:4103/health
SERVICE_NOTIFICATIONS_URL=http://localhost:4104/health
